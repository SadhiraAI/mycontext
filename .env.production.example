# Production environment variables
# Copy to .env or set via Fly.io secrets (fly secrets set KEY=VALUE)

ENVIRONMENT=production
DEBUG=false
PORT=8000

# Database (Neon PostgreSQL -- get from neon.tech dashboard)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.us-east-2.aws.neon.tech/mycontext?sslmode=require

# JWT secret -- MUST be unique and strong
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Fernet encryption key for user API keys
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# CORS -- only allow your production frontend
CORS_ORIGINS=https://mycontext.sadhiraai.com,https://sadhiraai.com

# Trusted hosts
ALLOWED_HOSTS=sadhiraai.com,mycontext.sadhiraai.com,api.sadhiraai.com

# Email verification (Resend)
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=mycontext AI <noreply@sadhiraai.com>
FRONTEND_URL=https://mycontext.sadhiraai.com
